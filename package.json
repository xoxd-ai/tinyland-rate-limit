{
  "name": "@tummycrypt/tinyland-rate-limit",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic rate limiting and CSRF protection middleware",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "author": "Tinyland.dev",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-rate-limit.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.11.0",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-rate-limit",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-rate-limit/issues"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
